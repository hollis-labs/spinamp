{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spinamp",
  "version": "0.2.0",
  "identifier": "fm.spinamp.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spinamp",
        "width": 860,
        "height": 980,
        "minWidth": 680,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Hollis Labs",
    "category": "Music",
    "copyright": "Copyright (c) 2026 Hollis Labs",
    "shortDescription": "A playlist-first music player that learns what you love",
    "longDescription": "Spinamp is a playlist-first music player with smart shuffle, discovery, prompt-to-playlist, lyrics and a visualizer that follows the song.",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
